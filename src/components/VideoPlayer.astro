---
import { localPath } from '../content';

interface Props {
  anchor: string;
  id: string;
  title: string;
  cover: { path: string; width: number; height: number };
  priority?: boolean;
}
const { anchor, id, title, cover, priority = false } = Astro.props;
const watch = 'https://www.youtube.com/watch?v=' + id;
const embed = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&playsinline=1';
---
<figure class="video-player" id={anchor}>
  <a class="video-trigger" href={watch} data-video-embed={embed} data-video-title={title} aria-label={'Assistir ao vídeo — ' + title}>
    <img src={localPath(cover.path)} width={cover.width} height={cover.height} loading={priority ? undefined : 'lazy'} fetchpriority={priority ? 'high' : undefined} alt="" />
    <span class="video-play" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="22" height="22" fill="currentColor"><path d="M6 3v14l11-7z" /></svg>
      Assistir ao vídeo
    </span>
  </a>
  <figcaption><a href={watch}>Abrir no YouTube</a></figcaption>
</figure>

<script>
  for (const trigger of document.querySelectorAll<HTMLAnchorElement>('[data-video-embed]')) {
    trigger.addEventListener('click', event => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
      const { videoEmbed, videoTitle } = trigger.dataset;
      if (!videoEmbed || !videoTitle) return;
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.className = 'video-frame';
      frame.title = videoTitle;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.src = videoEmbed;
      trigger.replaceWith(frame);
      frame.focus();
    });
  }
</script>

<style>
  .video-trigger {
    position: relative;
    display: block;
    aspect-ratio: var(--video-cover-ratio, 16 / 9);
    background: var(--ink);
    color: var(--cream);
    text-decoration: none;
  }
  .video-trigger img { width: 100%; height: 100%; object-fit: cover; }
  .video-play {
    position: absolute;
    right: clamp(10px, 2vw, 20px);
    top: clamp(10px, 2vw, 20px);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 48px;
    padding: 8px 13px;
    border: 2px solid var(--cream);
    border-radius: 4px;
    background: var(--ink);
    color: var(--cream);
    font-size: .875rem;
    font-weight: 750;
  }
  .video-trigger:hover .video-play { background: var(--accent); }
  .video-player :global(.video-frame) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--ink);
  }
  figcaption { margin-top: 4px; font-size: .83rem; }
  figcaption a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); }
  @media (max-width: 700px) {
    .video-play { top: auto; bottom: 10px; }
  }
</style>
