  down: 'M8 2v12m-5-5 5 5 5-5',
  pin: 'M13.5 6.5c0 4-5.5 8-5.5 8s-5.5-4-5.5-8a5.5 5.5 0 1 1 11 0Z M10 6.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  menu: 'M2 5h12M2 11h12',
  plus: 'M8 2v12M2 8h12',
