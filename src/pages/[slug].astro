---
import BlogArticle from '../components/BlogArticle.astro';
import ProcedurePage from '../components/ProcedurePage.astro';
import { blogPosts, type BlogPost } from '../blog';
import { procedurePages, procedureAliases, type ProcedurePage as ProcedureData } from '../procedures';

type Props = { kind: 'procedure'; page: ProcedureData } | { kind: 'post'; post: BlogPost };

export function getStaticPaths() {
  const procedures = procedurePages.map(page => ({ path: page.path, page }));
  const aliases = procedureAliases.map(({path,canonical}) => ({
    path,
    page: procedurePages.find(entry => entry.path === canonical)!,
  }));
  return [
    ...[...procedures, ...aliases].map(({path,page}) => ({
      params: { slug: path.slice(1,-1) },
      props: { kind: 'procedure', page } satisfies Props,
    })),
    ...blogPosts.map(post => ({
      params: { slug: post.slug },
      props: { kind: 'post', post } satisfies Props,
    })),
  ];
}

const route = Astro.props;
---
{route.kind === 'post' ? <BlogArticle post={route.post} /> : <ProcedurePage page={route.page} />}