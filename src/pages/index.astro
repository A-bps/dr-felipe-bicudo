---
import Site from '../layouts/Site.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Clinic from '../components/Clinic.astro';
import { clinics, credentials, doctor, localPath, procedures, whatsapp } from '../content';
import '../styles/home.css';
---
<Site>
  <Header />
  <main class="home" id="conteudo" tabindex="-1">
    <section class="cover wrap" aria-labelledby="cover-title">
      <div class="cover-masthead">
        <p>Cirurgia plástica e transplante capilar</p>
        <p class="cover-register">{doctor.crm} <span aria-hidden="true">/</span> {doctor.rqe}</p>
      </div>
      <h1 id="cover-title">Felipe Bicudo</h1>
      <figure class="cover-figure">
        <div class="cover-photo">
          <img src={localPath('/media/trajetoria.webp')} width="676" height="400" fetchpriority="high" alt="" />
        </div>
        <figcaption>Dr. Felipe Bicudo demonstra um modelo do couro cabeludo.</figcaption>
      </figure>
    </section>

    <section class="home-index" id="procedimentos" tabindex="-1" aria-labelledby="procedimentos-title">
      <div class="wrap">
        <div class="home-index-head">
          <h2 id="procedimentos-title">Procedimentos</h2>
          <a class="text-link" href={localPath('/procedimentos/')}>Ver catálogo completo <Icon name="diagonal" /></a>
        </div>
        <ul class="home-procedures">
          {procedures.map(({title,path,category}) => (
            <li><a href={localPath(path)}><span>{category}</span><h3>{title}</h3><Icon name="arrow" /></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="profile-ledger wrap" id="sobre" tabindex="-1" aria-labelledby="sobre-title">
      <div class="profile-intro">
        <h2 id="sobre-title">Formação e atuação</h2>
        <p>Dr. Felipe Bicudo é médico formado pela FAMERP, onde fez residência em Cirurgia Geral e Cirurgia Plástica. Atua em cirurgia plástica estética e reparadora, com foco em transplante capilar, e exerce atividade docente na Faculdade de Medicina FACERES.</p>
      </div>
      <dl class="profile-training" id="formacao">
        {credentials.map(([year,degree,school]) => (
          <div><dt>{year}</dt><dd><strong>{degree}</strong><span>{school}</span></dd></div>
        ))}
      </dl>
    </section>

    <section class="visit" id="clinicas" tabindex="-1" aria-labelledby="clinicas-title">
      <div class="wrap">
        <h2 id="clinicas-title">Consultórios</h2>
        <div class="visit-locations">{clinics.map(clinic => <Clinic {clinic} />)}</div>
        <div class="visit-contact" id="contato" tabindex="-1">
          <div>
            <h3>Agende sua consulta</h3>
            <p>Fale com a equipe para saber os horários disponíveis em cada unidade.</p>
          </div>
          <a class="button button-light" href={whatsapp}>Falar no WhatsApp <WhatsAppIcon /></a>
        </div>
      </div>
    </section>

    <section class="home-reading wrap" id="perguntas" aria-labelledby="faq-title">
      <h2 id="faq-title">Antes da consulta</h2>
      <div class="home-faq">
        <details><summary>Como agendar? <Icon name="plus" /></summary><p>Fale com a equipe pelo <a href={whatsapp}>WhatsApp</a> e informe a cidade onde prefere ser atendido.</p></details>
        <details><summary>O que posso conversar na primeira consulta? <Icon name="plus" /></summary><p>Você pode falar sobre seu histórico de saúde, suas expectativas e suas dúvidas. O médico avalia o caso e explica as opções, os riscos e os próximos passos.</p></details>
        <details><summary>Onde ficam os consultórios? <Icon name="plus" /></summary><p>Consulte o endereço e o mapa do <a href="#rio-preto">Georgina Business Park</a> ou da unidade de <a href="#votuporanga">Votuporanga</a>.</p></details>
      </div>
    </section>
  </main>
  <Footer />
</Site>
